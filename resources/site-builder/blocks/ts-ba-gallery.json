{
    "id": "ts-ba-gallery",
    "label": "Előtte-utána galéria",
    "category": "content",
    "icon": "compare",
    "keywords": [
        "galeria",
        "elotte",
        "utana",
        "slider",
        "osszehasonlitas",
        "munkaink"
    ],
    "scopes": [
        "page"
    ],
    "type": "static",
    "gjsType": "ts-ba-gallery",
    "interactive": true,
    "template": "ba-gallery.html",
    "params": [
        {
            "key": "title",
            "attr": "data-title",
            "label": "Cím",
            "type": "rich",
            "default": "Munkáink",
            "group": "content",
            "groupLabel": "Szöveges tartalom"
        },
        {
            "key": "items",
            "attr": "data-items",
            "label": "Képek",
            "type": "items",
            "group": "items",
            "groupLabel": "Képek",
            "itemLabel": "elem",
            "editLabel": "Képek szerkesztése",
